{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may only listen to and unlisten from events (core:event:default) and invoke this app's own commands.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-get-session",
    "allow-update-input",
    "allow-start-fetch",
    "allow-select-profile",
    "allow-select-region",
    "allow-confirm-connection-change",
    "allow-cancel-connection-change",
    "allow-reload-log-groups",
    "allow-update-log-group-filter",
    "allow-select-log-group",
    "allow-get-rows",
    "allow-set-failure-list-open",
    "allow-select-time-zone",
    "allow-set-log-filter",
    "allow-open-settings",
    "allow-cancel-settings",
    "allow-save-settings",
    "allow-clear-cache",
    "allow-row-positions",
    "allow-cancel-close",
    "allow-confirm-close"
  ]
}
